{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Ninja",
      "description": "Configure the project with Ninja and generate compile_commands.json",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_GAMES": "OFF",
        "OPENGL_VERSION": "4.3",
        "RAYLIBCPP_VERBOSE_FETCHCONTENT": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    }
  ]
}
